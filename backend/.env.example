# ==============================================================================
# Backend Configuration - Employee Referral Optimization Agent
# ==============================================================================

# --- Zoho Recruit OAuth2 Credentials (India Data Center) ---
# Obtain from https://api-console.zoho.in (Server-based Application)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Generated once using python scripts/get_zoho_refresh_token.py
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_RECRUIT_BASE_URL=https://recruit.zoho.in/recruit/v2

# --- Microsoft 365 / Entra ID (Graph API for Teams Meetings & Emails) ---
# Registered in Azure Portal -> Microsoft Entra ID -> App registrations
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox in your M365 tenant that organizes Teams meetings (UPN)
MS_ORGANIZER_UPN=
# Mailbox in your M365 tenant authorized to send notification emails (UPN)
MS_SENDER_UPN=

# --- iGentic AI Platform (Unified Multi-Agent App) ---
# Single iGentic app containing 3 participants: Group Chat Manager -> Referral_Agent / Analytics_Agent / Resume_Parser_Agent. Same credentials are used for chat AND resume parsing.
IGENTIC_EXECUTOR_URL=
IGENTIC_APP_ID=
IGENTIC_API_KEY=
IGENTIC_BEARER_TOKEN=
IGENTIC_USERNAME=
# IGENTIC_PARSER_EXECUTOR_URL=  # REMOVED — merged into main iGentic app
# IGENTIC_PARSER_APP_ID=        # REMOVED — merged into main iGentic app


# --- Security & Authentication ---
# 64-character hex secret for signing session JWTs (auto-generated by scripts/generate_secrets.py)
JWT_SECRET_KEY=
JWT_EXPIRY_HOURS=8
# Shared secret required in X-Agent-Key header when iGentic HTTP tools call backend
AGENT_API_KEY=
# APP_ENV: development | production
APP_ENV=development
# AUTH_MODE: otp | email_only (email_only is strictly forbidden when APP_ENV=production)
AUTH_MODE=otp

# --- Application Settings ---
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_BASE_URL=http://localhost:5173
MIN_ASSOCIATE_MATCH=40
POINTS_PER_REFERRAL=10
MAX_RESUME_MB=5
# RESUME_PARSER_MODE: auto | agent | python
RESUME_PARSER_MODE=auto
# JOB_MATCH_MODE: auto | agent | python
JOB_MATCH_MODE=auto

# Optional list of comma-separated recruiter emails to notify (if empty, notifies all active Zoho recruiters)
RECRUITER_NOTIFY_EMAILS=

# --- Zoho Candidate Status Mapping ---
STATUS_ON_REFERRAL=New
STATUS_ON_APPROVAL=In-Review
STATUS_ON_REJECTION=Rejected
STATUS_ON_INTERVIEW_SCHEDULED=Interview Scheduled
